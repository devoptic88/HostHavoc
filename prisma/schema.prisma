generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROVISIONING
  ACTIVE
  SUSPENDED
  GRACE_PERIOD
  CANCELLED
  FAILED
  MANUAL // VPS/dedicated orders fulfilled by hand
  // LITE only: the game server is deleted from the panel but its files are
  // archived, so the order keeps its save slot without holding a deploy slot.
  HIBERNATING
}

/// PRO = premium always-on server with a static address and automated tasks.
/// LITE = budget "wake & play": sleeps when unused and frees its deploy slot.
enum PlanTier {
  PRO
  LITE
}

enum ProductType {
  GAME_SERVER
  VPS
  DEDICATED
}

enum TicketStatus {
  OPEN
  ANSWERED
  CUSTOMER_REPLY
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           Role     @default(CUSTOMER)
  pteroUserId    Int?     @unique // Pterodactyl application-API user id
  paymenterUserId Int?    @unique // Paymenter admin-API user id
  dateFormat     String   @default("iso") // iso | us | eu
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders  Order[]
  tickets Ticket[]
  ticketMessages TicketMessage[]
}

model Plan {
  id          String      @id @default(cuid())
  productType ProductType
  gameSlug    String? // links to game content file for GAME_SERVER plans
  name        String
  slots       Int?
  ramMb       Int
  cpuPercent  Int // pterodactyl cpu limit (100 = 1 core)
  diskMb      Int
  databases   Int         @default(1)
  backups     Int         @default(2)
  tier        PlanTier    @default(PRO)
  // How many servers of this plan a customer may run at once, and (LITE only)
  // how many hibernated instances they may keep parked.
  deploySlots Int         @default(1)
  saveSlots   Int         @default(1)
  backupStorageMb Int     @default(20480)
  priceMonthly Decimal    @db.Decimal(10, 2)
  paymenterProductId Int? @unique
  eggId       Int? // pterodactyl egg to deploy
  nestId      Int?
  nodeId      Int? // pin deployment to one pterodactyl node (null = customer's location)
  sortOrder   Int         @default(0)
  active      Boolean     @default(true)

  orders Order[]

  @@index([productType, gameSlug])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  planId        String
  status        OrderStatus @default(PENDING)
  productType   ProductType
  serverName    String
  locationId    Int? // pterodactyl location id chosen at checkout
  pteroServerId Int? // application-API server id once provisioned
  pteroServerIdentifier String? // client-API short uuid
  paymenterOrderId Int?    @unique // Paymenter order id whose lifecycle drives provisioning
  rustAllocations Json?
  rustInstallProfile String?
  rustPendingReinstallProfile String?
  // When the customer accepted the Minecraft EULA at checkout. Provisioning
  // writes eula=true only once this is set, so the agreement is always the
  // customer's, never ours.
  minecraftEulaAcceptedAt DateTime?
  // DNS label under SERVER_DOMAIN, e.g. "survival" -> survival.hypernode.gg.
  // Unique so two servers can never claim the same address.
  subdomain     String?     @unique
  // Redirects web-browser traffic hitting the server's IP/hostname to our
  // website instead of a raw connection-refused/timeout.
  webRedirect   Boolean     @default(false)
  // Hides the server's public IP from the dashboard/header/overview and
  // redacts client IPs from console output, for safe streaming.
  streamerMode  Boolean     @default(false)
  // IANA timezone the gameserver container runs in (e.g. "America/New_York").
  // Null means the node's default timezone.
  timezone      String?
  // LITE hibernation: when the instance was parked, and where its archived
  // files live so a later wake can restore them onto a fresh server.
  hibernatedAt  DateTime?
  hibernationArchiveUrl String?
  // True while the archive-and-delete (or restore-and-wake) background job
  // is running, so the UI can show progress instead of a stale ACTIVE state.
  hibernationPending Boolean @default(false)
  // 0-100 while hibernationPending is true, plus a short human label for
  // whichever step is running (e.g. "Uploading to storage", "Restoring files").
  hibernationProgress Int?
  hibernationStage    String?
  // Bytes of backup storage this order is currently using, refreshed when the
  // backups page loads so the account total doesn't need N panel calls.
  backupBytes   BigInt      @default(0)
  deleteAfterAt DateTime?
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([deleteAfterAt])
}

model RustNodeConfig {
  id             String   @id @default(cuid())
  nodeId         Int      @unique
  enabled        Boolean  @default(false)
  allocationIp   String
  allocationAlias String?
  portRanges     String
  portStride     Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Ticket {
  id        String         @id @default(cuid())
  userId    String
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  fromStaff Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

/// Key/value app configuration editable from Admin → Settings.
/// Values here override environment variables of the same name.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  body      String // markdown
  coverImage String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  category  String // e.g. game slug or "general"
  title     String
  body      String // markdown
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}
